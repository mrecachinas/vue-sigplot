{
  "name": "vue-sigplot",
  "version": "1.0.0",
  "description": "Vue wrapper for SigPlot",
  "homepage": "https://github.com/lgsinnovations/vue-sigplot",
  "author": {
    "name": "LGS Innovations",
    "email": "sigplot@lgsinnovations.com",
    "url": "https://www.lgsinnovations.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lgsinnovations/vue-sigplot.git"
  },
  "bugs": {
    "url": "https://github.com/lgsinnovations/vue-sigplot/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/vue-sigplot.umd.js",
  "module": "./dist/vue-sigplot.es.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/vue-sigplot.es.js",
      "require": "./dist/vue-sigplot.umd.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly",
    "clean": "rm -rf ./dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write"
  },
  "dependencies": {
    "sigplot": "^2.0.0-rc20"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/vue": "^8.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "canvas": "^2.11.2",
    "jest-canvas-mock": "^2.5.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "vitest-canvas-mock": "^1.1.3",
    "vue": "^3.5.0",
    "vue-tsc": "^2.0.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
